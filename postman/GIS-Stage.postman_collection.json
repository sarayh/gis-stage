          "name": "Generate Test Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Data generated successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log(\"Generated:\");",
                  "    console.log(\"- Services: \" + jsonData.statistics.services);",
                  "    console.log(\"- Etudiants: \" + jsonData.statistics.etudiants);",
                  "    console.log(\"- Stages: \" + jsonData.statistics.stages);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
