# =============================================================================
# GIS-Stage - Configuration Backend
# =============================================================================
# Copiez ce fichier vers .env et modifiez les valeurs
# cp .env.example .env
# =============================================================================

# ===== APPLICATION =====
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# ===== BASE DE DONNÉES =====
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://gis_user:gis_password@db:5432/gis_stage
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=gis_password
POSTGRES_DB=gis_stage

# ===== JWT (IMPORTANT: Générer une clé unique en production) =====
# Générer avec: openssl rand -hex 32
JWT_SECRET_KEY=CHANGEZ_MOI_AVEC_UNE_CLE_GENEREE_PAR_OPENSSL
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== UPLOADS =====
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE=5242880

# ===== LIMITES =====
MAX_STAGES_YEAR=2000
MAX_ETUDIANTS=5000
MAX_DOCS_PER_STAGE=10
RATE_LIMIT_REQUESTS=30

# ===== CONFIGURATION SH (Mission-Critique) =====
SH_DEFAULT_MAX_ITEMS=10000
SH_MAX_SERVICES=100
SH_MAX_ETABLISSEMENTS=200
SH_MAX_PRESENCES_BATCH=500
SH_CORRELATION_DOMAIN=GIS
